{
  "name": "mcpulse-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "esbuild tests/check.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check.test.mjs --log-level=error && node node_modules/.cache/check.test.mjs && npm run test:frontmatter && npm run test:brand && npm run test:highlight",
    "test:frontmatter": "esbuild tests/frontmatter.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/frontmatter.test.mjs --log-level=error && node node_modules/.cache/frontmatter.test.mjs",
    "test:brand": "esbuild tests/brand.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/brand.test.mjs --log-level=error && node node_modules/.cache/brand.test.mjs",
    "test:highlight": "esbuild tests/highlight.test.ts --bundle --platform=node --format=esm --define:import.meta.env.SITE='\"https://www.getmcpulse.com\"' --outfile=node_modules/.cache/highlight.test.mjs --log-level=error && node node_modules/.cache/highlight.test.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.2.1",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
