---
import { publishedPosts } from "../../lib/posts";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { PER_PAGE, pageCount } from "../../lib/posts";
import { SITE } from "../../lib/site";
import { breadcrumbs } from "../../lib/schema";

/**
 * The index, in three tiers rather than one grid.
 *
 * Twenty identical cards is a list, and a list of twenty tells a reader
 * nothing about where to start — every post claims the same importance, so the
 * page defers the whole decision to them. The tiers are the recommendation:
 * the newest post gets a spread, the two behind it get half a row each, and
 * the rest get an even grid because past the third item recency stops being a
 * reason to look.
 *
 * It is also what makes the covers big enough to be worth drawing. One column
 * of twenty at card size is a lot of small pictures; this way the first three
 * are large enough to read as images and the remainder still carry one.
 */

const posts = await publishedPosts();

/**
 * Page one. Later pages are `/blog/page/N`.
 *
 * `posts` stays the full list because the header's count and the `Blog`
 * structured data describe the archive, not this page of it — a reader told
 * "45 posts" and shown twelve has been told the truth about the archive.
 */
const totalPages = pageCount(posts.length);
const page = posts.slice(0, PER_PAGE);

/** For the header's own line — a count is the honest measure of an archive. */
const topics = [...new Set(posts.map((post) => post.data.topic))];


/**
 * The index, described as a blog with its posts listed.
 *
 * The `ItemList` is the part that earns its keep: this page is the only URL
 * that links to all twenty-two posts, and the tiered layout means the last
 * dozen sit far enough down that a crawler on a budget may not reach them.
 * Naming them in the graph is a second, cheaper route to the same pages —
 * belt and braces alongside the sitemap.
 */
const schema = [
  {
    "@type": "Blog",
    "@id": new URL("/blog", Astro.site).href,
    name: `${SITE.name} — writing on MCP server observability`,
    description:
      "Retries, empty results, schema cost, and what the four outcomes of a tool call actually tell you.",
    url: new URL("/blog", Astro.site).href,
    inLanguage: "en-GB",
    publisher: { "@id": `${SITE.url}/#organization` },
    blogPost: posts.map((post) => ({
      "@type": "BlogPosting",
      "@id": `${new URL(`/blog/${post.id}`, Astro.site).href}#article`,
      headline: post.data.title,
      url: new URL(`/blog/${post.id}`, Astro.site).href,
      datePublished: post.data.published.toISOString(),
    })),
  },
  breadcrumbs(Astro.site, [
    { name: SITE.name, path: "/" },
    { name: "Blog", path: "/blog" },
  ]),
];
---

<Base
  title="Blog"
  description="Writing about MCP server observability — retries, empty results, schema cost, and what the four outcomes actually tell you."
  schema={schema}
>
  <section class="relative overflow-hidden border-b border-line-soft">
    <div aria-hidden="true" class="grid-fade absolute inset-0 -z-10"></div>

    <div class="mx-auto max-w-7xl px-5 pt-36 pb-16 sm:px-8 sm:pt-44">
      <div class="reveal max-w-3xl">
        <p class="text-sm font-medium text-cyan">Writing</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance text-ink-100 sm:text-5xl">
          Notes on measuring what models do with your tools
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-pretty text-ink-500">
          Everything here comes out of building MCPulse: the metrics that turned out to matter, the
          ones that did not, and the parts of MCP that are easy to get wrong.
        </p>

        <p class="mt-7 flex flex-wrap items-center gap-x-2 gap-y-1.5 text-xs text-ink-700">
          <span>{posts.length} posts</span>
          {
            topics.map((topic) => (
              <>
                <span aria-hidden="true">·</span>
                <span>{topic}</span>
              </>
            ))
          }
        </p>
      </div>
    </div>
  </section>

  <PostList posts={page} featuredFirst current={1} total={totalPages} />
</Base>
