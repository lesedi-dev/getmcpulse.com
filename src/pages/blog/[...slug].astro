---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCover from "../../components/PostCover.astro";
import { SITE, CTA } from "../../lib/site";
import { article, breadcrumbs } from "../../lib/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content } = await render(post);

/** Three from the same topic, falling back to the newest if a topic is thin. */
const all = (await getCollection("blog")).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const others = all.filter((entry) => entry.id !== post.id);
/**
 * Three rather than two, now that the blog is out of the header.
 *
 * These links are how somebody moves between posts: there is no menu item to
 * go back up to, so the foot of an article is the only navigation an article
 * has. Three fits the same row a two-card grid was using half of.
 */
const related = [
  ...others.filter((entry) => entry.data.topic === post.data.topic),
  ...others.filter((entry) => entry.data.topic !== post.data.topic),
].slice(0, 3);

const published = post.data.published.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

/**
 * The post, described as a post.
 *
 * Every page on this site used to hand Google the same `SoftwareApplication`
 * block, which on an essay about retry semantics is not a small inaccuracy —
 * it is the page telling a search engine it is a piece of software. A
 * `BlogPosting` with a real date is also what makes the post eligible for the
 * dated, breadcrumbed result rather than a bare blue link.
 */
const schema = [
  article(Astro.site, {
    path: `/blog/${post.id}`,
    title: post.data.title,
    description: post.data.description,
    published: post.data.published,
    topic: post.data.topic,
    minutes: post.data.minutes,
  }),
  breadcrumbs(Astro.site, [
    { name: SITE.name, path: "/" },
    { name: "Blog", path: "/blog" },
    { name: post.data.title, path: `/blog/${post.id}` },
  ]),
];
---

<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  published={post.data.published}
  schema={schema}
>
  {/* A reading position, drawn by CSS and nothing else.
      `animation-timeline` needs no scroll listener, so this costs no
      JavaScript and cannot jank the scroll it is describing. It is behind
      `@supports` because a browser without it would paint a bar that never
      moves — a progress indicator stuck at zero is worse than none. */}
  <div aria-hidden="true" class="read-progress"></div>

  <article>
    <header class="relative overflow-hidden border-b border-line-soft">
      <div aria-hidden="true" class="grid-fade absolute inset-0 -z-10"></div>

      {/* The same max-w-6xl container every other page uses, with the reading
          column centred inside it — so the page keeps the site's structure
          while the article itself sits in the middle of the screen. */}
      <div class="mx-auto max-w-6xl px-5 pt-36 sm:px-8 sm:pt-44">
        <div class="mx-auto max-w-3xl">
          <a
            href="/blog"
            class="-my-2 inline-block py-2 text-sm text-ink-500 transition-colors hover:text-cyan"
            >← All posts</a
          >

          <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-ink-700">
            <span class="rounded-full bg-cyan-wash px-2.5 py-1 font-medium text-cyan">
              {post.data.topic}
            </span>
            <time datetime={post.data.published.toISOString()}>{published}</time>
            <span aria-hidden="true">·</span>
            <span>{post.data.minutes} min read</span>
          </div>

          <h1
            class="mt-5 text-3xl font-semibold tracking-tight text-balance text-ink-100 sm:text-[2.75rem] sm:leading-[1.1]"
          >
            {post.data.title}
          </h1>
          <p class="mt-5 text-lg leading-8 text-pretty text-ink-500">{post.data.description}</p>
        </div>
      </div>

      {/* The cover breaks the reading column and runs the full container.
          That is the point of it: the text is a 3xl measure because prose is
          unreadable wider, and an image held to the same measure is a picture
          apologising for being there. It is `hero` density, because at this
          size the gridlines and the callout are legible rather than lint. */}
      <div class="mx-auto mt-12 max-w-6xl px-5 pb-14 sm:px-8">
        <div class="overflow-hidden rounded-2xl border border-line bg-ink-950/50">
          <PostCover
            topic={post.data.topic}
            seed={post.id}
            density="hero"
            class="aspect-[2/1] w-full sm:aspect-[5/2]"
          />
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <div class="prose mx-auto max-w-3xl">
        <Content />
      </div>
    </div>
  </article>

  <aside class="border-t border-line-soft">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
      <div class="mx-auto max-w-3xl rounded-2xl border border-line bg-ink-900/40 p-7">
        <h2 class="text-lg font-semibold tracking-tight text-ink-100">
          Measure this on your own server
        </h2>
        <p class="mt-2 text-sm leading-6.5 text-ink-500">
          Two lines inside your process. Never your arguments, never your results.
        </p>
        <a
          href={SITE.signup}
          class="mt-5 inline-flex h-10 items-center rounded-xl bg-btn px-4 text-sm font-medium text-btn-fg transition-colors hover:bg-btn-hover"
        >
          {CTA.primary}
        </a>
      </div>

      {/* Three cards with covers, at the full container width rather than
          held to the reading column. With the blog out of the header this is
          the only navigation an article has, so it gets to look like
          somewhere to go rather than like a footnote. */}
      {
        related.length > 0 && (
          <>
            <h2 class="mt-16 flex items-center gap-4 text-xs font-medium tracking-wide text-ink-700 uppercase">
              Keep reading
              <span aria-hidden="true" class="h-px flex-1 bg-line-soft" />
            </h2>

            <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((entry) => (
                <li>
                  <a
                    href={`/blog/${entry.id}`}
                    class="group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-colors hover:border-cyan/25 hover:bg-surface-2"
                  >
                    <div class="overflow-hidden border-b border-line bg-ink-950/50">
                      <PostCover
                        topic={entry.data.topic}
                        seed={entry.id}
                        class="aspect-[2/1] w-full transition-transform duration-700 ease-out-quint group-hover:scale-[1.04]"
                      />
                    </div>

                    <div class="flex flex-1 flex-col p-5">
                      <div class="flex items-center gap-2.5 text-xs text-ink-700">
                        <span class="font-medium text-cyan-dim">{entry.data.topic}</span>
                        <span aria-hidden="true">·</span>
                        <span>{entry.data.minutes} min</span>
                      </div>
                      <span class="mt-2.5 text-[15px] leading-6.5 font-semibold text-balance text-ink-100 transition-colors group-hover:text-cyan">
                        {entry.data.title}
                      </span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </aside>
</Base>

<style is:global>
  /**
   * How far through you are, with no scroll listener.
   *
   * `animation-timeline: scroll()` drives the width off the document's own
   * scroll position, so the browser advances it on the compositor — a JS
   * listener would be doing the same arithmetic on the main thread, on every
   * frame, of the scroll it is trying to describe.
   *
   * The whole thing is inside `@supports`, so a browser without scroll-driven
   * animations gets no element rather than a bar frozen at zero, which reads
   * as broken rather than absent. `prefers-reduced-motion` keeps it: this is
   * position, not decoration — it moves only because the page moved, which is
   * exactly the kind of motion that rule is not about.
   */
  @supports (animation-timeline: scroll()) {
    .read-progress {
      position: fixed;
      /* Sits on the nav's bottom border rather than above it, so it does not
         add a second horizontal line to the top of the page. */
      top: 3.9375rem;
      left: 0;
      z-index: 50;
      height: 2px;
      width: 100%;
      transform-origin: 0 50%;
      background-color: var(--color-cyan);
      scale: 0 1;
      animation: read-progress-grow linear both;
      animation-timeline: scroll(root block);
    }

    @keyframes read-progress-grow {
      to {
        scale: 1 1;
      }
    }
  }

  /**
   * Article typography.
   *
   * Written by hand rather than pulled from a plugin: the posts use six
   * elements between them, and a typography dependency to style six elements
   * is more configuration than CSS.
   */
  .prose {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ink-300);
  }

  .prose > * + * {
    margin-top: 1.4em;
  }

  .prose h2 {
    margin-top: 2.6em;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--color-ink-100);
    text-wrap: balance;
  }

  .prose h3 {
    margin-top: 2.2em;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-ink-100);
  }

  .prose strong {
    font-weight: 600;
    color: var(--color-ink-100);
  }

  .prose a {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklch, var(--color-cyan) 40%, transparent);
    transition: text-decoration-color 0.2s;
  }

  .prose a:hover {
    text-decoration-color: var(--color-cyan);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.3em;
  }

  .prose ul {
    list-style: disc;
  }

  .prose ol {
    list-style: decimal;
  }

  .prose li::marker {
    color: var(--color-ink-700);
  }

  .prose li + li {
    margin-top: 0.5em;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background-color: color-mix(in oklch, var(--color-ink-800) 55%, transparent);
    color: var(--color-ink-100);
  }

  .prose pre {
    /* Long lines scroll inside the block rather than widening the page. */
    overflow-x: auto;
    padding: 1.1rem 1.25rem;
    border-radius: 0.9rem;
    border: 1px solid var(--color-line);
    background-color: color-mix(in oklch, var(--color-ink-900) 60%, transparent);
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .prose pre code {
    padding: 0;
    background: none;
    font-size: inherit;
    color: var(--color-ink-300);
  }

  .prose blockquote {
    padding-left: 1.15em;
    border-left: 2px solid var(--color-cyan);
    color: var(--color-ink-500);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    display: block;
    overflow-x: auto;
  }

  .prose th,
  .prose td {
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--color-line-soft);
    text-align: left;
    vertical-align: top;
  }

  .prose th {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-500);
  }

  .prose hr {
    margin-block: 2.6em;
    border: 0;
    border-top: 1px solid var(--color-line-soft);
  }
</style>
