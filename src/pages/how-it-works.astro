---
import Detail from "../layouts/Detail.astro";
import { highlight } from "../lib/highlight";
import PillarVisual from "../components/PillarVisual.astro";
import DataFlow from "../components/DataFlow.astro";
import Faq from "../components/Faq.astro";
import { OUTCOMES, PILLARS } from "../lib/content";
import { SITE } from "../lib/site";

/**
 * How it works, at the length the question deserves.
 *
 * This page was 382 words — the shortest on the site, and the one a reader
 * opens while deciding whether to put our code inside their process. Three
 * paragraphs and a payload is not an answer to that; it is a summary of one.
 *
 * What was added is not padding. Each section answers a question a sceptical
 * engineer actually asks next, in the order they ask it: where does my traffic
 * go, what exactly leaves, what does it cost me, how do you know a crash from
 * an error, and what can you *not* see. That last one is the section most
 * products leave out, which is why it is the one that earns the rest.
 */

const PAYLOAD = `{
  "v": 1,
  "type": "call",
  "session_id": "s_7f2a91",
  "tool_name": "search_orders",
  "client_name": "claude-desktop",
  "started_at": "2026-08-09T14:22:31Z",
  "duration_ms": 240,
  "outcome": "ok",
  "response_bytes": 1420,
  "is_empty": false,
  "args_hash": "9c1b4e2f0a11"
}`;

const PAYLOAD_TOKENS = highlight(PAYLOAD);

/** Every field, and the reason it cannot hold anything of yours. */
const FIELDS = [
  { f: "session_id", t: "opaque id", w: "Groups calls in one conversation. Generated by us, means nothing outside your account." },
  { f: "tool_name", t: "your name", w: "The name you registered. This is the one field you chose, and it is a name rather than data." },
  { f: "client_name", t: "dimension", w: "Which client connected — claude-desktop, cursor. Reported by the client itself." },
  { f: "started_at", t: "timestamp", w: "When the call began, so a day can be drawn by the hour." },
  { f: "duration_ms", t: "number", w: "How long your handler took. Bucketed on our side, because percentiles cannot be summed." },
  { f: "outcome", t: "enum", w: "One of four: ok, empty, tool_error, crashed. Nothing else is possible." },
  { f: "response_bytes", t: "number", w: "The size of your answer, which is what context actually costs. Not the answer." },
  { f: "is_empty", t: "boolean", w: "Whether a successful call returned nothing usable. The failure the protocol calls success." },
  { f: "args_hash", t: "hash", w: "Twelve hex characters of a SHA-256 over the arguments, keys sorted. One way, and truncated." },
] as const;

/**
 * The chip row, worded to match the headings it jumps to.
 *
 * A contents link that says something different from the heading it lands on
 * makes a reader wonder whether the jump worked. These were written before the
 * headings were rewritten and three of them had drifted — "Three decisions" for
 * a section now called "The three design decisions behind it", and so on.
 */
const SECTIONS = [
  { id: "path", label: "Where your traffic goes" },
  { id: "decisions", label: "The design decisions" },
  { id: "payload", label: "What leaves your process" },
  { id: "outcomes", label: "The four outcomes of a call" },
  { id: "cannot", label: "What MCPulse cannot see" },
  { id: "questions", label: "Common questions" },
] as const;
---

<Detail
  eyebrow="How it works"
  title="How MCPulse sees your server without touching its traffic"
  lead="Nothing about your server should have to change so that you can see it — not its URL, not its auth, not its dependencies, and not its uptime."
  description="How MCPulse collects data: an npm package inside your own server, sizes and hashes only, two lines to install."
  width="full"
  sections={SECTIONS}
>
  <div class="space-y-24">
    <!-- ── The path ───────────────────────────────────────────────────── -->
    <section id="path" class="scroll-mt-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="reveal text-2xl font-semibold tracking-tight text-ink-100">
          Where your traffic goes
        </h2>
        <p class="reveal mt-4 text-[15px] leading-7 text-ink-500">
          Straight to your server, exactly as it did before. The SDK is a package inside your
          process, so there is no hop to add, no URL to change and no certificate to manage. What
          leaves for us leaves separately, after your response has already gone back.
        </p>
      </div>

      <DataFlow class="reveal mt-10" />

      <div class="reveal mx-auto mt-8 grid max-w-3xl gap-4 sm:grid-cols-3">
        {
          [
            ["Not on the request path", "Recording happens after your handler returns. A tool call never waits on us."],
            ["Not a dependency", "Zero runtime dependencies. Nothing enters your tree and nothing of ours can be compromised through one."],
            ["Not able to break it", "Every path through the SDK is wrapped. If recording fails, it fails silently rather than turning a working call into an error."],
          ].map(([t, d]) => (
            <div class="rounded-xl border border-line bg-surface p-5">
              <p class="text-sm font-medium text-ink-100">{t}</p>
              <p class="mt-2 text-sm leading-6.5 text-ink-500">{d}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── The three decisions ────────────────────────────────────────── -->
    <section id="decisions" class="scroll-mt-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="reveal text-2xl font-semibold tracking-tight text-ink-100">
          The three design decisions behind it
        </h2>
        <p class="reveal mt-4 text-[15px] leading-7 text-ink-500">
          Each one is a place where the easier product to build was the wrong one to ship.
        </p>
      </div>

      <div
        class="reveal mt-10 grid gap-px overflow-hidden rounded-2xl border border-line bg-line lg:grid-cols-3"
      >
        {
          PILLARS.map((pillar, i) => (
            <article class="min-w-0 bg-ink-950 p-5 sm:p-7" style={`--reveal-delay: ${i * 90}ms`}>
              <PillarVisual kind={pillar.kind} />
              <span class="mt-6 block font-mono text-xs text-ink-700">0{i + 1}</span>
              <h3 class="mt-3 text-lg font-semibold tracking-tight text-ink-100">{pillar.title}</h3>
              <p class="mt-3 text-sm leading-6.5 text-ink-500">{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ── The payload ────────────────────────────────────────────────── -->
    <section id="payload" class="scroll-mt-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="reveal text-2xl font-semibold tracking-tight text-ink-100">
          What leaves your process
        </h2>
        <p class="reveal mt-4 text-[15px] leading-7 text-ink-500">
          One object per tool call. Every field is a dimension, a duration, a size or a hash — there
          is no field that could hold customer data, which is a stronger statement than a promise
          about how the fields are used.
        </p>
      </div>

      <div class="reveal mt-10 grid gap-4 lg:grid-cols-[minmax(0,22rem)_1fr]">
        <pre
          class="term overflow-x-auto rounded-xl p-5 font-mono text-[12.5px] leading-6"><code>{PAYLOAD_TOKENS.map((t) => (t.cls ? <span class={t.cls}>{t.text}</span> : t.text))}</code></pre>

        <div class="overflow-hidden rounded-xl border border-line">
          <table class="w-full border-collapse text-left text-sm">
            <thead>
              <tr class="border-b border-line-soft bg-surface-2">
                <th class="px-4 py-2.5 text-[11px] font-medium tracking-wide text-ink-700 uppercase">Field</th>
                <th class="hidden px-4 py-2.5 text-[11px] font-medium tracking-wide text-ink-700 uppercase sm:table-cell">Kind</th>
                <th class="px-4 py-2.5 text-[11px] font-medium tracking-wide text-ink-700 uppercase">Why it is safe</th>
              </tr>
            </thead>
            <tbody>
              {
                FIELDS.map((field) => (
                  <tr class="border-b border-line-soft last:border-b-0">
                    <td class="px-4 py-3 align-top font-mono text-[12.5px] whitespace-nowrap text-ink-100">
                      {field.f}
                    </td>
                    <td class="hidden px-4 py-3 align-top font-mono text-[11px] whitespace-nowrap text-cyan sm:table-cell">
                      {field.t}
                    </td>
                    <td class="px-4 py-3 align-top text-[13px] leading-6 text-ink-500">{field.w}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <p class="reveal mx-auto mt-6 max-w-3xl text-sm leading-6.5 text-ink-700">
        And once at startup, the tool list with the byte size of each schema. That second payload is
        what makes dead tools findable: a tool with no calls has no rows anywhere, so absence has to
        be recorded from the other side.
      </p>
    </section>

    <!-- ── The four outcomes ──────────────────────────────────────────── -->
    <section id="outcomes" class="scroll-mt-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="reveal text-2xl font-semibold tracking-tight text-ink-100">
          Every call ends as exactly one of four things
        </h2>
        <p class="reveal mt-4 text-[15px] leading-7 text-ink-500">
          Telling <code class="rounded bg-surface-2 px-1 py-0.5 font-mono text-[0.85em] text-ink-100">crashed</code>
           from <code class="rounded bg-surface-2 px-1 py-0.5 font-mono text-[0.85em] text-ink-100">tool_error</code>
           takes some doing. The MCP SDK catches everything a tool throws and turns it into a result
          with <code class="rounded bg-surface-2 px-1 py-0.5 font-mono text-[0.85em] text-ink-100">isError: true</code>,
           so from outside the request handler a bug and a deliberate error are the same object. The
          SDK wraps your tool callbacks as well as the request, so what actually happened is known
          rather than guessed from an error message.
        </p>
      </div>

      <ul class="reveal mt-10 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          OUTCOMES.map((outcome) => (
            <li class="bg-ink-950 p-6">
              <p class={`font-mono text-sm ${outcome.tone}`}>{outcome.name}</p>
              <p class="mt-2 text-sm leading-6.5 text-ink-500">{outcome.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="reveal mx-auto mt-6 max-w-3xl rounded-xl border border-warn/20 bg-warn/[0.04] p-5">
        <p class="text-sm font-medium text-ink-100">And a fifth state riding alongside them</p>
        <p class="mt-2 text-sm leading-6.5 text-ink-500">
          <code class="rounded bg-surface-2 px-1 py-0.5 font-mono text-[0.85em] text-ink-100">is_empty</code>
           marks a call that succeeded and returned nothing usable — an empty array, an empty object,
          a blank string. Those are the failures nobody reports: the protocol calls them success, the
          model gets nothing it can use, and you never hear about it.
        </p>
      </div>
    </section>

    <!-- ── The limits ─────────────────────────────────────────────────── -->
    <section id="cannot" class="scroll-mt-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="reveal text-2xl font-semibold tracking-tight text-ink-100">
          What MCPulse cannot see
        </h2>
        <p class="reveal mt-4 text-[15px] leading-7 text-ink-500">
          The design that keeps your data out also keeps some answers out. It is worth knowing which
          before you install, rather than after you go looking for one.
        </p>

        <ul class="reveal mt-8 space-y-3">
          {
            [
              ["Why a call failed", "We record that your handler threw, not what it threw. The message could contain anything, so it never leaves. Your own logs have the stack trace."],
              ["What the model was trying to do", "There is no prompt, no reasoning and no user text anywhere in the payload. We can tell you a tool was retried with different arguments; we cannot tell you what was asked."],
              ["Which specific argument was wrong", "bad_args is counted, and identical argument shapes are grouped by hash so you can see one pattern repeating. Which field, and what was in it, stays with you."],
              ["Whether the answer was correct", "A call that returned 1,420 bytes of confident nonsense is recorded as ok. Correctness needs a reader, and we are not reading your results."],
            ].map(([t, d]) => (
              <li class="flex gap-4 rounded-xl border border-line bg-surface p-5">
                <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink-700" />
                <div>
                  <p class="text-sm font-medium text-ink-100">{t}</p>
                  <p class="mt-1.5 text-sm leading-6.5 text-ink-500">{d}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <p class="reveal mt-6 text-sm leading-6.5 text-ink-700">
          A product that could answer all four would be reading your traffic, and then the honest
          version of this page would be a much longer document about retention.
        </p>
      </div>
    </section>

    <!-- ── Questions ──────────────────────────────────────────────────── -->
    <section id="questions" class="scroll-mt-24">
      <div class="mx-auto max-w-3xl">
        <h2 class="reveal text-2xl font-semibold tracking-tight text-ink-100">
          Common questions
        </h2>
        <Faq class="reveal mt-8" limit={4} />
        <p class="reveal mt-6 text-sm text-ink-700">
          <a href="/faq" class="font-medium text-cyan hover:underline">Every question</a>
           — languages, getting at your own data, and what a security review will ask. Or
          <a href={SITE.docs} class="font-medium text-cyan hover:underline">read the docs</a>.
        </p>
      </div>
    </section>
  </div>
</Detail>
