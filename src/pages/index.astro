---
import Base from "../layouts/Base.astro";
import InstallSequence from "../components/InstallSequence.astro";
import HeroPanel from "../components/HeroPanel.astro";
import PillarVisual from "../components/PillarVisual.astro";
import { SITE, INSTALL_COMMAND } from "../lib/site";
import { OUTCOMES, PILLARS, METRICS, INSIGHTS } from "../lib/content";

---

<Base>
  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="grid-fade absolute inset-0 -z-10"></div>
    <div
      aria-hidden="true"
      class="absolute -top-40 left-1/2 -z-10 h-[30rem] w-[60rem] -translate-x-1/2 rounded-full bg-cyan/[0.07] blur-3xl"
    >
    </div>

    <div
      class="mx-auto max-w-6xl px-5 pt-36 pb-24 sm:px-8 sm:pt-44 sm:pb-32 xl:min-h-[54rem] xl:pb-24"
    >
      <div class="reveal max-w-3xl xl:max-w-[34rem]">
        {/* Whichever post we are currently leading with. Hardcoded rather
            than read from the collection, because "newest" is not the same as
            "worth interrupting a first-time reader for", and this is the only
            slot above the headline. Changing it should be a deliberate edit. */}
        <a
          href="/blog/reading-5000-mcp-schemas"
          class="inline-flex items-center gap-2 rounded-full border border-line bg-surface-2 py-1 pr-3 pl-1 text-xs text-ink-300 transition-colors hover:border-cyan/30 hover:text-ink-100"
        >
          <span class="rounded-full bg-cyan-wash px-2 py-0.5 font-medium text-cyan">New</span>
          We read the schemas of 4,951 MCP servers →
        </a>

        <h1
          class="mt-6 text-4xl font-semibold tracking-tight text-balance text-ink-100 sm:text-6xl sm:leading-[1.05] xl:text-5xl xl:leading-[1.08]"
        >
          Your MCP server works.
          {/* Its own line from xl, where the panel narrows the column enough
              that the second sentence would otherwise start mid-line. */}
          <span class="text-ink-700 xl:block">Does it work for the model?</span>
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-pretty text-ink-500 sm:text-xl">
          You publish a server and see nothing — not which tools get called, not whether the model
          understands your descriptions, not what your server costs the people running it. MCPulse
          answers that, from two lines inside your own process.
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={SITE.app}
            class="inline-flex h-11 items-center justify-center rounded-xl bg-btn px-5 text-sm font-medium text-btn-fg transition-colors hover:bg-btn-hover"
          >
            Start measuring — free
          </a>

          <button
            type="button"
            data-copy={INSTALL_COMMAND}
            class="group inline-flex h-11 items-center justify-between gap-4 rounded-xl border border-line bg-surface px-4 font-mono text-sm text-ink-300 transition-colors hover:border-line-strong hover:text-ink-100"
          >
            <span><span class="text-cyan-dim">$</span> {INSTALL_COMMAND}</span>
            <span data-copy-label class="text-xs text-ink-700 group-hover:text-ink-500">copy</span>
          </button>
        </div>

        <p class="mt-5 text-sm text-ink-700">
          Node 20.12+ · zero runtime dependencies · works with any MCP transport
        </p>
      </div>
    </div>

    <!-- The app itself, floated past the container's right edge and allowed to
         run off the viewport. Sized to the real page rather than to the space
         left over — cropping it is what makes it read as a window onto
         something bigger instead of a picture that happens to fit. Absolute,
         so nothing in the hero's flow has to make room for it.

         Height is capped and the fade measured against that cap, not against
         the panel's own length. Masking the full panel put the fade below the
         section's overflow-hidden, so it was sliced flat before it ever
         started dissolving. -->
    <div
      class="reveal pointer-events-none absolute top-40 left-[calc(50%+2.5rem)] hidden h-[42rem] w-[68rem] overflow-hidden [mask-image:linear-gradient(to_bottom,black_62%,transparent_97%)] xl:block"
      style="--reveal-delay: 200ms"
      aria-hidden="true"
    >
      <HeroPanel />
    </div>
  </section>

  <!-- ── The four outcomes ─────────────────────────────────────────────── -->
  <!-- Its own band rather than part of the hero: every number further down the
       page is one of these four counted a different way, and the floating
       panel needs the hero's full height. -->
  <section class="border-t border-line-soft">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
      <ul
        class="reveal grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          OUTCOMES.map((outcome) => (
            <li class="bg-ink-950 p-5">
              <p class={`font-mono text-sm ${outcome.tone}`}>{outcome.name}</p>
              <p class="mt-2 text-sm leading-6 text-ink-500">{outcome.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── How it works ──────────────────────────────────────────────────── -->
  <section id="how" class="scroll-mt-24 border-t border-line-soft">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
      <div class="reveal max-w-2xl">
        <p class="text-sm font-medium text-cyan">How it works</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-100 sm:text-4xl">
          Three decisions, and they are all the same decision
        </h2>
        <p class="mt-4 text-lg leading-7 text-ink-500">
          Nothing about your server should have to change so that you can see it.
        </p>
      </div>

      <!-- `min-w-0` on each card because a grid item's default
           `min-width: auto` will not shrink below its content's min-content
           width — and an SVG with no width/height has an intrinsic 300px. That
           floor made every card 363px wide inside a 280px column at 320px,
           where the grid's own overflow-hidden quietly cropped the right edge.
           Padding eases off on small screens for the same reason. -->
      <div class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-line bg-line lg:grid-cols-3">
        {
          PILLARS.map((pillar, i) => (
            <article
              class="reveal min-w-0 bg-ink-950 p-5 sm:p-7"
              style={`--reveal-delay: ${i * 90}ms`}
            >
              <PillarVisual kind={pillar.kind} />
              <span class="mt-6 block font-mono text-xs text-ink-700">0{i + 1}</span>
              <h3 class="mt-3 text-lg font-semibold tracking-tight text-ink-100">{pillar.title}</h3>
              <p class="mt-3 text-sm leading-6.5 text-ink-500">{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Install ───────────────────────────────────────────────────────── -->
  <div class="border-t border-line-soft">
    <InstallSequence />
  </div>

  <!-- ── Insights ──────────────────────────────────────────────────────── -->
  <section class="border-t border-line-soft">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
      <div class="reveal max-w-2xl">
        <p class="text-sm font-medium text-cyan">Insights</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-100 sm:text-4xl">
          A tool name, a number, and a consequence
        </h2>
        <p class="mt-4 text-lg leading-7 text-ink-500">
          A dashboard that makes you work out what to do with it has done half the job. Every
          insight names the tool, counts the thing, and says what it is costing you.
        </p>
      </div>

      <div class="mt-12 grid gap-4 lg:grid-cols-2">
        {
          INSIGHTS.map((insight, i) => (
            <article
              class:list={[
                "reveal rounded-2xl border p-5",
                insight.tone === "bad"
                  ? "border-bad/20 bg-bad/[0.04]"
                  : "border-warn/20 bg-warn/[0.04]",
              ]}
              style={`--reveal-delay: ${(i % 2) * 90}ms`}
            >
              <p class="font-mono text-sm text-ink-100">{insight.tool}</p>
              <p class="mt-2 text-[15px] leading-7 text-ink-300">{insight.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Metrics ───────────────────────────────────────────────────────── -->
  <section id="metrics" class="scroll-mt-24 border-t border-line-soft">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
      <div class="reveal max-w-2xl">
        <p class="text-sm font-medium text-cyan">Metrics</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-100 sm:text-4xl">
          Sixteen numbers, and where each one comes from
        </h2>
        <p class="mt-4 text-lg leading-7 text-ink-500">
          Most are counted as your calls arrive. Three need a night's worth of calls in order and
          are labelled as of yesterday, because pretending otherwise would be the first lie the
          product told you.
        </p>
      </div>

      {/* Numbered straight through 01–16 across the three groups, so the
          count in the heading is something you can verify rather than take on
          trust. `index` walks the flattened list. */}
      <div class="mt-16 space-y-12">
        {
          METRICS.map((column, groupIndex) => {
            const offset = METRICS.slice(0, groupIndex).reduce((n, g) => n + g.items.length, 0);

            return (
              <section class="reveal">
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-line pb-4">
                  <h3 class="flex items-center gap-2.5 text-[15px] font-semibold tracking-tight text-ink-100">
                    <span aria-hidden="true" class:list={["h-1.5 w-1.5 rounded-full", column.dot]} />
                    {column.group}
                  </h3>
                  <p class="text-sm text-ink-700">{column.note}</p>
                  {/* Spelled out. A bare "11" beside tiles numbered 01–16 reads
                      as another index rather than a count of the group. */}
                  <p class="ml-auto text-xs text-ink-700">
                    {column.items.length} metrics
                  </p>
                </div>

                {/* Spaced cards rather than a hairline grid sharing one
                    background. A group of 11 in three columns leaves a cell
                    empty, and with the grid's own background showing through
                    that gap rendered as a filled tile — a box with nothing in
                    it, in a section about there being sixteen of something. */}
                <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                  {column.items.map((item, i) => (
                    <li class="group relative overflow-hidden rounded-xl border border-line bg-surface p-5 transition-colors hover:border-line-strong hover:bg-surface-2">
                      {/* The rule lights up on hover instead of a border moving,
                          so nothing in the grid shifts by a pixel. */}
                      <span
                        aria-hidden="true"
                        class:list={[
                          "absolute inset-y-0 left-0 w-0.5 origin-top scale-y-0 transition-transform duration-300 group-hover:scale-y-100",
                          column.dot,
                        ]}
                      />

                      <div class="flex items-baseline gap-3">
                        <span class="font-mono text-xs text-ink-700">
                          {String(offset + i + 1).padStart(2, "0")}
                        </span>
                        <h4 class="text-[15px] leading-6 font-medium text-ink-100">{item.name}</h4>
                      </div>

                      <p class="mt-2 pl-8 text-sm leading-6 text-ink-500">{item.detail}</p>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }
      </div>

      <p class="reveal mt-12 max-w-3xl border-l-2 border-warn/40 pl-5 text-[15px] leading-7 text-ink-500">
        Retries are the hard one, and the one worth having. Within a session, the same tool called
        twice inside 30 seconds with <em class="text-ink-100 not-italic">different</em> arguments is
        the model rewording and trying again. With the <em class="text-ink-100 not-italic">same</em>
        arguments it is pagination or polling, and it is not a retry. Get that distinction wrong and
        every well-behaved paginating tool grades as broken.
      </p>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────── -->
  <section class="border-t border-line-soft">
    <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
      <div
        class="reveal relative overflow-hidden rounded-3xl border border-line bg-ink-900/50 px-6 py-16 text-center sm:px-16"
      >
        <div
          aria-hidden="true"
          class="absolute -top-24 left-1/2 -z-10 h-64 w-[40rem] -translate-x-1/2 rounded-full bg-cyan/10 blur-3xl"
        >
        </div>

        <h2 class="text-3xl font-semibold tracking-tight text-balance text-ink-100 sm:text-4xl">
          Find out what your tools are actually doing
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-lg leading-7 text-pretty text-ink-500">
          Create an MCP, paste the key, restart. The first payload lands before you have finished
          reading the install page.
        </p>

        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <a
            href={SITE.app}
            class="inline-flex h-11 items-center justify-center rounded-xl bg-btn px-5 text-sm font-medium text-btn-fg transition-colors hover:bg-btn-hover"
          >
            Start measuring — free
          </a>
          <a
            href={SITE.npm}
            class="inline-flex h-11 items-center justify-center rounded-xl border border-line px-5 text-sm font-medium text-ink-300 transition-colors hover:border-line-strong hover:text-ink-100"
          >
            Read the package docs
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  /**
   * Copy the install command.
   *
   * The label reverts after a moment: a button stuck on "copied" leaves you
   * unsure whether the second click did anything.
   */
  const button = document.querySelector<HTMLButtonElement>("[data-copy]");
  const label = button?.querySelector<HTMLElement>("[data-copy-label]");

  button?.addEventListener("click", async () => {
    if (!label) return;

    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      label.textContent = "copied";
    } catch {
      // Clipboard access can be refused outright — say so rather than
      // claiming a copy that did not happen.
      label.textContent = "press ⌘C";
    }

    window.setTimeout(() => (label.textContent = "copy"), 2000);
  });
</script>
