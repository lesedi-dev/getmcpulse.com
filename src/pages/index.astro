---
import Base from "../layouts/Base.astro";
import InstallSequence from "../components/InstallSequence.astro";
import HeroPanel from "../components/HeroPanel.astro";
import PillarVisual from "../components/PillarVisual.astro";
import ToolTable from "../components/ToolTable.astro";
import PricingCards from "../components/PricingCards.astro";
import Proof from "../components/Proof.astro";
import Featured from "../components/Featured.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE, CTA } from "../lib/site";
import { PILLARS, METRICS, FAQS, PLANS } from "../lib/content";
import { STUDY } from "../lib/study";

/**
 * ── What this page is for ─────────────────────────────────────────────────
 * One reader, one decision: an MCP server author deciding whether to install
 * something. Everything here is either a reason to say yes or a reason not to
 * worry, in the order those questions get asked.
 *
 * ── The rewrite, and what was wrong ───────────────────────────────────────
 * The previous version was twelve sections and about 114KB. It was well written
 * — genuinely, in places beautifully — and it lost on three counts.
 *
 * 1. It sold the category. "Analytics for MCP servers" is the same phrase
 *    PostHog, AgentCat, BetterMeter and Sentry use for the same thing. Two of
 *    those are free and at least one is already installed in the reader's
 *    stack, and this page never acknowledged that any of them existed.
 *
 * 2. It was written to be read, not scanned. Long sentences, aphorisms, a
 *    catalogue of sixteen metrics enumerated in full. A visitor four seconds
 *    into a page they did not plan to be on does not read essays.
 *
 * 3. It buried both moats. The privacy guarantee — the one thing here no
 *    competitor can copy, because they all record arguments and responses —
 *    was FAQ item two, framed as an objection. The 4,749-server corpus was
 *    section nine.
 *
 * ── The rule for editing this file ────────────────────────────────────────
 * Short sentences. Concrete nouns. A number wherever a number exists. If a line
 * could appear on any of the four competitors' home pages, it is not earning
 * its place — cut it or make it specific.
 */

/** One button style for the "read the detail page" links. */
const BUTTON =
  "inline-flex h-10 items-center rounded-xl border border-line bg-surface px-4 text-sm font-medium text-ink-100 transition-colors hover:border-line-strong hover:bg-surface-2";

/**
 * The four facts under the fold-line, chosen to answer four different fears.
 *
 * Not decoration and not vanity metrics: each one is the short answer to a
 * question that otherwise stops somebody installing. Is there anything behind
 * this (the corpus), will it bloat my tree (dependencies), can you see my data
 * (no), how much of my afternoon is this (two lines).
 */
const TRUST = [
  { figure: STUDY.servers.toLocaleString("en-GB"), label: "public servers analysed" },
  { figure: "0", label: "runtime dependencies" },
  // "None / of your arguments or results" was a sentence cut in half across a
  // figure and its label, and it read as neither. Every other item here is a
  // count, so the odd one out has to at least be a phrase that stands up on its
  // own line. "Never" does; "None" needed the label to finish it.
  { figure: "Never", label: "sees your arguments or results" },
  { figure: "2", label: "lines to install" },
];

/**
 * The problem, as three things a log file cannot show you.
 *
 * All three are real failure modes with a number attached, and all three are
 * invisible to the tooling the reader already has — which is the point. A
 * retried call is three successful calls in a log. An empty result is a 200. A
 * dead tool never appears at all, because nothing happened.
 */
const BLIND_SPOTS = [
  {
    tone: "bad",
    tool: "search_orders",
    title: "Agents retry it and you cannot see that",
    body: "The agent asks, gets something it cannot use, and asks again with different arguments — 2.4 times on average before it gives up. Your logs show three or four successful calls.",
  },
  {
    tone: "warn",
    tool: "get_invoice",
    title: "It returns nothing, successfully",
    body: "An empty list is still a success. No error is raised, nothing is logged as a failure, and the agent got nothing it could use. 12% of this tool's calls end that way.",
  },
  {
    tone: "warn",
    tool: "export_report",
    title: "Nobody has ever called it",
    body: "Registered, described, and dead. It still costs 480 tokens of schema in every single session, crowding the context agents use to pick between the tools that do work.",
  },
];

/**
 * "What to look at" — the dashboard's own insight panel, rebuilt here.
 *
 * The three cards above it explain why your existing tooling misses these
 * failures. This is what the product actually hands you once it has a week of
 * traffic: a short list, each line naming one tool, one number, and what it is
 * costing. Argument first, then the deliverable.
 *
 * ── Why the numbers are the page's, not the panel's ───────────────────────
 * The dashboard panel this was taken from runs on a different sample server —
 * `find_product`, `sync_catalog`, 62% first-call, 3,724 calls. Pasting those in
 * would put a fourth set of tool names on a page where the hero panel, the tool
 * table and the cards all already use `search_orders`, `get_invoice`,
 * `list_customers` and `export_report`. Two demos that disagree read as a
 * product that cannot count.
 *
 * So the shape, the icons and the sentence patterns are the dashboard's. The
 * tools and figures are the ones already on this page, and the money is derived
 * from the call counts in `ToolTable` rather than invented — if the table
 * changes, these change with it.
 */
const LOOK_AT = [
  {
    tone: "bad",
    icon: "trending-down",
    title: "Agents struggle with search_orders",
    body: "Only 68% of calls to <code>search_orders</code> succeed first time. Agents retried it 2.4 times on average across 4,120 calls.",
  },
  {
    tone: "warn",
    icon: "info",
    title: "get_invoice returns empty results",
    // 306, not 312: the table's row is 12% of 2,551 calls, and 312 was the
    // server-wide empty count from the hero panel's Outcomes bar — two different
    // figures that happened to be near enough to look like one.
    body: "306 calls to <code>get_invoice</code> returned empty with no error — 12% of 2,551 calls. The agent was told these succeeded.",
  },
  {
    tone: "warn",
    icon: "ghost",
    title: "export_report has never been called",
    body: "<code>export_report</code> has never been called but costs 480 tokens of schema every session — $1.73 across 1,200 sessions in this range.",
  },
  {
    tone: "warn",
    icon: "triangle-alert",
    // 14 kB of JSON is roughly 3.5k tokens, not 14k. This said "roughly $0.04
    // of context each time — $120 across 3,008 calls", which prices it as if
    // the kilobytes were tokens and lands about four times too high. The table
    // directly below prints "14 kB" in the same row, so the two numbers were
    // visibly contradicting each other on one screen — and over-stating a cost
    // is the one direction of error this product cannot afford, given the whole
    // pitch is that its figures are ones you can recompute.
    title: "list_customers returns a lot of context",
    body: "<code>list_customers</code> returns 14 kB per call — about 3.5k tokens, roughly $0.01 of context each time, and $32 across 3,008 calls.",
  },
];

/**
 * Lucide paths, inlined. Four icons is not worth a dependency, and a runtime
 * icon library would be the only JavaScript on this page drawing something the
 * markup can draw itself.
 */
const ICONS: Record<string, string> = {
  "trending-down": '<path d="M16 17h6v-6"/><path d="m22 17-8.5-8.5-5 5L2 7"/>',
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  ghost:
    '<path d="M9 10h.01"/><path d="M15 10h.01"/><path d="M12 2a8 8 0 0 0-8 8v12l3-3 2.5 2.5L12 19l2.5 2.5L17 19l3 3V10a8 8 0 0 0-8-8z"/>',
  "triangle-alert":
    '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
};

/**
 * The three reasons to pick this over the tracing the reader already has.
 *
 * These stay as behaviours rather than brand names — they are the argument, and
 * an argument that depends on who is on the other side of it is a weaker one.
 * The named comparison below turns each of them into a checkable claim.
 */
const DIFFERENCE = [
  {
    // "durations, sizes, and twelve hex characters of a hash" is precise and it
    // is the wrong register for the card that has to land in one read. The
    // exact hash construction is on /how-it-works, where somebody who wants it
    // will go looking; here it only has to be obvious that nothing readable
    // leaves the process.
    title: "It cannot read your traffic",
    body: "The usual way to measure a tool call is to record it: the arguments going in, the answer coming back, sometimes the whole session. This records how long the call took, how big the answer was, and a scrambled fingerprint of the arguments. Nothing that could hold a customer record ever leaves your server.",
  },
  {
    title: "It knows what good looks like",
    body: "Your tool descriptions are scored against the whole ecosystem, not against your own last week. A trace viewer has one server in it: yours. It can never tell you that two of your tools read as the same thing to the agent choosing between them.",
  },
  {
    // "retry this one" read as an instruction to the reader — the one thing the
    // product never says. It reports that the *model* retried, which is the
    // opposite direction, and on a card whose whole point is "we tell you what
    // to do" a misread verb is expensive. Each clause is now an action the
    // reader takes.
    title: "It names the tool to fix",
    body: "A trace is evidence you still have to read. This is a list: reword this one, this one comes back empty, delete this one. The teams that fixed tool selection cut tools rather than added dashboards — and cutting means knowing which.",
  },
];

/**
 * The named comparison.
 *
 * ── Why name them ─────────────────────────────────────────────────────────
 * Because the reader already has. Somebody evaluating this has PostHog or
 * Sentry open in another tab, and a page that describes "the usual way to
 * measure a tool call" without saying whose way it is asks them to do the
 * mapping themselves — which they will do badly, or not at all, and leave.
 *
 * ── The rules this table is written under ─────────────────────────────────
 * Every cell is from the other product's own public documentation, read in
 * September 2026, and the date is printed under the table so the claim ages
 * visibly instead of quietly. Where a competitor does something well it says so
 * — PostHog captures the advertised tool list, which is genuine dead-tool
 * detection, and the row credits it. A comparison that loses every row is not
 * read as a comparison, it is read as marketing, and it takes the credibility
 * of the schema survey down with it.
 *
 * If any of this stops being true, fix the row. An out-of-date comparison table
 * naming real companies is worse than having none.
 *
 * BetterMeter is deliberately not a column. Its documentation is thin enough
 * that every cell would be a guess, and a guess about a named competitor is the
 * one thing this table cannot contain. It is named in the footnote instead.
 */
const COMPARISON = {
  columns: ["MCPulse", "PostHog", "AgentCat", "Sentry"],
  rows: [
    {
      label: "Sees your arguments and results",
      values: [
        { text: "Never — sizes and a hash", tone: "good" },
        { text: "Yes", tone: "plain" },
        { text: "Yes, plus session replay", tone: "plain" },
        { text: "Yes", tone: "plain" },
      ],
    },
    {
      label: "First-call success and retry rate",
      values: [
        { text: "Yes", tone: "good" },
        { text: "No", tone: "plain" },
        { text: "No", tone: "plain" },
        { text: "No", tone: "plain" },
      ],
    },
    {
      label: "Scored against public servers",
      values: [
        { text: `${STUDY.servers.toLocaleString("en-GB")} servers`, tone: "good" },
        { text: "No", tone: "plain" },
        { text: "No", tone: "plain" },
        { text: "No", tone: "plain" },
      ],
    },
    {
      label: "Dead tools and schema cost",
      values: [
        { text: "Yes", tone: "good" },
        // "Tool list captured" was accurate and meant nothing to a reader who
        // has not read PostHog's event reference. PostHog records the advertised
        // tool list, which gets you dead tools; it does not size the schemas, so
        // it cannot tell you what they cost.
        { text: "Dead tools only", tone: "plain" },
        { text: "No", tone: "plain" },
        { text: "No", tone: "plain" },
      ],
    },
    {
      label: "Languages",
      values: [
        { text: "TypeScript", tone: "plain" },
        { text: "TypeScript", tone: "plain" },
        { text: "TypeScript", tone: "plain" },
        { text: "Several", tone: "plain" },
      ],
    },
    {
      label: "Free tier",
      values: [
        { text: "1 server, 10k calls", tone: "plain" },
        { text: "Yes", tone: "plain" },
        { text: "500 sessions a month", tone: "plain" },
        { text: "On every plan", tone: "plain" },
      ],
    },
  ],
} as const;

const schema = [
  {
    "@type": "SoftwareApplication",
    name: SITE.name,
    description: SITE.description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any",
    url: new URL("/", Astro.site).href,
    publisher: { "@id": `${SITE.url}/#organization` },
    offers: PLANS.map((plan) => ({
      "@type": "Offer",
      name: plan.name,
      price: plan.price.month,
      priceCurrency: "USD",
      url: SITE.signup,
    })),
  },
  {
    "@type": "FAQPage",
    mainEntity: FAQS.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<Base schema={schema}>
  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  {/*
    Two columns that both end, rather than one column and a screenshot running
    off the edge.

    The old hero floated a 68rem dashboard mock out past the container and let
    it bleed off the viewport, cropped and unreadable, with the left column
    ending 200px above the section's floor — so the first screen of the site was
    a headline, a paragraph, and a large area of nothing next to a picture you
    could not read. It was doing the job of texture and none of the job of
    proof.

    What replaced it is small enough to read. Four rows of a tool table, two of
    them flagged, is this entire product in one glance: these are your tools,
    this is which ones the model is failing on. A reader who understands the
    picture has understood the offer before reaching the second section.
  */}
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="grid-fade absolute inset-0 -z-10"></div>
    <div
      aria-hidden="true"
      class="absolute -top-40 left-1/2 -z-10 h-[30rem] w-[60rem] -translate-x-1/2 rounded-full bg-cyan/[0.07] blur-3xl"
    >
    </div>

    <div class="mx-auto max-w-7xl px-5 pt-24 pb-16 sm:px-8 sm:pt-28 sm:pb-20 xl:min-h-[48rem] xl:pb-24">
      <div class="grid items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:gap-16 xl:block">
        <div class="reveal xl:max-w-[34rem]">
          <p class="text-sm font-medium tracking-wide text-cyan">Analytics for MCP servers</p>

          {/*
            The headline names the reader's problem in their own words.

            "Make models pick the right tool, first time" was the promise, and a
            promise is one step further from the reader than their symptom. What
            somebody actually arrives thinking is "my server works and the agent
            still fumbles it" — so the headline is that thought, finished.

            "Gets wrong" rather than anything more precise, because precision
            here costs comprehension: retries, empty results, bad arguments and
            dead tools are four different failures and the reader does not yet
            have names for them. They all feel like the tool being wrong.
          */}
          {/*
            "Agents", not "models" — and it is a consistency fix as much as a
            word choice.

            This page used both for the same actor: fifteen "model" and nine
            "agent", sometimes in adjacent blocks. Worse, the dashboard itself
            says "Agents struggle with search_orders" and "Agents retried it",
            so a visitor learned one vocabulary here and a second one the moment
            they signed up.

            "Agents" wins on all three counts. It is what the ecosystem writes —
            Sentry describes "the agents and LLMs that invoke them", PostHog
            "how AI agents use your MCP tools", AgentCat "how agents experience
            your product". It is what this product's own UI already says. And it
            is the more concrete of the two: an agent *does* things — calls,
            retries, gives up, never calls at all — where a model predicts. Every
            verb on this page is a behaviour, so the noun in front of them should
            be the one that behaves.

            "The model" survives only where the claim is literally about reading
            a description and choosing between tools, which is the model's job
            inside the agent rather than the agent's.
          */}
          <h1
            class="mt-4 text-4xl font-semibold tracking-tight text-balance text-ink-100 sm:text-5xl sm:leading-[1.08]"
          >
            Find out which of your tools
            <span class="text-ink-700">agents get wrong</span>
          </h1>

          <p class="mt-6 max-w-xl text-lg leading-8 text-pretty text-ink-500">
            MCPulse shows you which tools AI agents retry, which come back empty, and which they
            never call at all. Two lines inside your own server. It never sees your arguments or
            your results.
          </p>

          {/*
            Two buttons. The second one is the only free thing in this market
            that asks for nothing at all.

            Every route to value here except the checker needs an account, an
            install, a redeploy and a night of traffic before three of the
            headline metrics populate. Against competitors who are free or
            already installed, that is a hard first visit to win. The checker
            ends in a real answer about the reader's own server, in their own
            browser, in about fifteen seconds.
          */}
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href={SITE.signup}
              class="inline-flex h-12 items-center justify-center rounded-xl bg-btn px-6 text-[15px] font-medium text-btn-fg transition-colors hover:bg-btn-hover"
            >
              {CTA.primary}
            </a>
            <a
              href="/check"
              class="inline-flex h-12 items-center justify-center rounded-xl border border-line px-6 text-[15px] font-medium text-ink-300 transition-colors hover:border-line-strong hover:text-ink-100"
            >
              Score my schemas free
            </a>
          </div>

          {/*
            Price, commitment and the language limit, on one line.

            TypeScript is here rather than in the FAQ because the install page
            opens on ten SDKs with nine marked coming soon, and a Python author
            who finds that out two clicks in has caught the site overstating —
            which then costs the schema survey its credibility too. Losing that
            reader in four seconds is cheaper than losing the ones who stay.
          */}
          {/* This said "TypeScript SDK today — other languages are not ready
              yet", which was true of one SDK and is now true of none: all ten
              official MCP SDKs have an MCPulse package. The line was costing
              every Python and Go author on the page. */}
          {/* "Free forever", not "Free for one server".

              The two say different things and belong in different places. This
              line sits under the button and answers "what does saying yes cost
              me" — and the answer is nothing, ever, because the free tier is a
              tier rather than a trial. "One server" is a plan *limit*, which is
              the pricing section's job further down; putting it here spends the
              reader's attention on a cap before they have any reason to care
              what the caps are. */}
          <p class="mt-5 text-sm text-ink-300">
            Free forever. No card, no trial to expire.
            <a
              href="/install"
              class="text-ink-500 underline-offset-2 hover:text-ink-100 hover:underline"
              >All ten MCP SDKs</a
            > supported.
          </p>
        </div>

        {/*
          The product, small enough to read.

          Hand-built rather than the full dashboard mock because it has one job:
          show that the output is a list of tools with named problems. The
          numbers match the ones the sections below use, so the page tells one
          story with one set of figures rather than three demos that disagree.
        */}
        {/*
          The small-screen visual, and only that.

          Below `xl` there is no room for a dashboard to run off the edge — a
          cropped panel on a laptop is just a picture with its right-hand third
          missing. So this compact card carries the same argument in the space
          that exists: four tools, two of them flagged. Above `xl` it gives way
          to the real panel below, which has the room to show the clients row and
          the outcomes beside the tools.
        */}
        <div class="reveal min-w-0 xl:hidden" style="--reveal-delay: 150ms">
          <div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-2xl shadow-black/20">
            <div class="flex items-center justify-between border-b border-line px-5 py-3.5">
              <p class="text-sm font-medium text-ink-100">Tool health</p>
              <p class="font-mono text-xs text-ink-700">last 7 days</p>
            </div>

            <table class="w-full text-left">
              <thead>
                <tr class="border-b border-line-soft text-[11px] tracking-wide text-ink-700 uppercase">
                  <th scope="col" class="px-5 py-2.5 font-medium">Tool</th>
                  <th scope="col" class="px-3 py-2.5 text-right font-medium">Calls</th>
                  <th scope="col" class="px-3 py-2.5 text-right font-medium">First-call</th>
                  <th scope="col" class="px-5 py-2.5 text-right font-medium">Verdict</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line-soft">
                <tr class="bg-bad/[0.05]">
                  <td class="px-5 py-3 font-mono text-[13px] text-ink-100">search_orders</td>
                  <td class="px-3 py-3 text-right font-mono text-[13px] text-ink-500">4,120</td>
                  <td class="px-3 py-3 text-right font-mono text-[13px] text-bad">68%</td>
                  <td class="px-5 py-3 text-right text-[13px] text-bad">Retried 2.4×</td>
                </tr>
                {/* `create_order` rather than `list_customers`, which sat here
                    marked "Healthy" while the desktop panel and the full table
                    both flag it for a 14 kB response. Rather than colour a
                    fourth row and leave this card with nothing healthy on it,
                    it shows one of the two tools that genuinely are fine — so
                    the card stays a true subset of the table instead of
                    contradicting it. */}
                <tr>
                  <td class="px-5 py-3 font-mono text-[13px] text-ink-100">create_order</td>
                  <td class="px-3 py-3 text-right font-mono text-[13px] text-ink-500">1,904</td>
                  <td class="px-3 py-3 text-right font-mono text-[13px] text-ok">97%</td>
                  <td class="px-5 py-3 text-right text-[13px] text-ink-700">Healthy</td>
                </tr>
                <tr class="bg-warn/[0.05]">
                  <td class="px-5 py-3 font-mono text-[13px] text-ink-100">get_invoice</td>
                  <td class="px-3 py-3 text-right font-mono text-[13px] text-ink-500">2,551</td>
                  <td class="px-3 py-3 text-right font-mono text-[13px] text-warn">88%</td>
                  <td class="px-5 py-3 text-right text-[13px] text-warn">12% empty</td>
                </tr>
                <tr class="bg-warn/[0.05]">
                  <td class="px-5 py-3 font-mono text-[13px] text-ink-100">export_report</td>
                  <td class="px-3 py-3 text-right font-mono text-[13px] text-ink-700">0</td>
                  <td class="px-3 py-3 text-right font-mono text-[13px] text-ink-700">—</td>
                  <td class="px-5 py-3 text-right text-[13px] text-warn">Never called</td>
                </tr>
              </tbody>
            </table>

            {/* No count here on purpose. This card shows four of the server's
                six tools, so any number it printed would disagree with the full
                table further down — which is exactly what happened: this said
                "3 tools need attention" while the table said 2 and the insight
                panel said 4. The table is the place that can count, because it
                is the only one showing every row. */}
            <div class="border-t border-line bg-surface-2 px-5 py-3.5">
              <p class="text-[13px] leading-6 text-ink-500">
                <span class="font-medium text-ink-100">Needs attention.</span> export_report costs 480
                tokens of schema every session and has never been called.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/*
      The dashboard, floated past the container's right edge and allowed to run
      off the viewport.

      Sized to the real page rather than to the space left over, because
      cropping it is what makes it read as a window onto something bigger rather
      than a picture that happens to fit. Absolute, so nothing in the hero's flow
      has to make room for it.

      What it shows was reordered for this position: clients first, then tool
      health, then outcomes — see the note in `HeroPanel.astro`. Everything right
      of about 60% is decoration, so the two rows that carry the argument are the
      two on the left.

      The height cap and the mask go together. Masking the full panel put the
      fade below the section's `overflow-hidden`, so it was sliced flat before it
      ever started dissolving; measuring the fade against the cap is what makes
      it end in a gradient instead of an edge.
    */}
    <div
      class="reveal pointer-events-none absolute top-36 left-[calc(50%+2.5rem)] hidden h-[40rem] w-[68rem] overflow-hidden rounded-2xl [mask-image:linear-gradient(to_bottom,black_74%,transparent_99%)] xl:block"
      style="--reveal-delay: 200ms"
      aria-hidden="true"
    >
      <HeroPanel />
    </div>
  </section>

  <!-- ── Trust strip ───────────────────────────────────────────────────── -->
