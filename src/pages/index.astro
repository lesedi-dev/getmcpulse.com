        </div>
      </div>
    </div>
  </section>

  <Proof />

  <!-- ── Questions ─────────────────────────────────────────────────────── -->
  {/*
    The objections, before the last ask rather than after it.

    Every one of these was already answered somewhere on the site — in a pillar,
