---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../lib/site";
import { ogImageFor, OG_WIDTH, OG_HEIGHT } from "../lib/og";
import { website } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
  /** Set on blog posts so the card renders as an article rather than the site. */
  type?: "website" | "article";
  published?: Date;
  /** Last meaningful edit. Feeds `article:modified_time` and the JSON-LD. */
  updated?: Date;
  /**
   * Keep the page out of search results.
   *
   * Only `/404` sets this. A soft-404 that returns 200 and asks to be indexed
   * is how a site ends up with a "Nothing here" page ranking for its own name.
   */
  noindex?: boolean;
  /**
   * Structured data for this page, replacing the site-level default.
   *
   * A blog post described as a `SoftwareApplication` — which is what every page
   * here claimed before — tells Google the wrong thing about twenty-two of the
   * twenty-eight URLs on the site. A page that knows better says so.
   *
   * An array becomes several nodes in the one graph, which is how a page says
   * "this is an article *and* here is its breadcrumb trail" without repeating
   * the publisher in both.
   */
  schema?: unknown | unknown[];
}

const {
  title,
  description = SITE.description,
  type = "website",
  published,
  updated,
  noindex = false,
  schema,
} = Astro.props;

/**
 * The brand suffix, but only when it fits.
 *
 * Google renders about 60 characters of a title and cuts the rest, and it cuts
 * from the end — so `" — MCPulse"` appended to a title that is already 58
 * characters long does not add the brand, it removes eight words of headline
 * and shows the brand to nobody. Twelve of the twenty-two posts here were over
 * the limit, one of them by thirty characters.
 *
 * When the suffix does not fit it is dropped, and nothing is lost: `og:site_name`
 * and the `WebSite` node both name the site, which is where Google takes the
 * site name in a result from anyway.
 */
const BRAND = ` — ${SITE.name}`;
const TITLE_BUDGET = 60;

const full_title = !title
  ? `${SITE.name} — ${SITE.tagline}`
  : title.length + BRAND.length <= TITLE_BUDGET
    ? title + BRAND
    : title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/**
 * The share card, absolute.
 *
 * `og:image` is the one tag in this head that a relative path breaks outright:
 * the crawler reading it is not on this origin and has nothing to resolve
 * against, so Slack and LinkedIn show the blank box rather than guessing.
 */
const og_image = new URL(await ogImageFor(Astro.url.pathname), Astro.site).href;

/**
 * The organisation, referenced by `@id` rather than restated.
 *
 * Every page's structured data needs a publisher, and three copies of the same
 * organisation with no shared identifier read as three organisations. One node,
 * one `@id`, pointed at from wherever it is needed.
 */
const publisher = {
  "@type": "Organization",
  "@id": `${SITE.url}/#organization`,
  name: SITE.name,
  url: new URL("/", Astro.site).href,
  logo: new URL("/favicon.svg", Astro.site).href,
  sameAs: [SITE.github, SITE.npm],
};

const default_schema = {
  "@type": "SoftwareApplication",
  name: SITE.name,
  description: SITE.description,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  // `new URL` rather than `SITE.url`, so this reads `https://getmcpulse.com/`
  // like the canonical tag and the `WebSite` node beside it, not the bare
  // origin `SITE.url` happens to hold.
  url: new URL("/", Astro.site).href,
  publisher: { "@id": publisher["@id"] },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    description: "Free for one server.",
  },
};

/**
 * One `@graph` rather than several `<script>` tags.
 *
 * Separate blocks are legal, but they cannot reference each other's nodes, so
 * the publisher has to be repeated in each. A graph lets the page state the
 * organisation once and have the article and the website both point at it.
 */
const nodes = schema === undefined ? [default_schema] : Array.isArray(schema) ? schema : [schema];

/**
 * `Organization` and `WebSite` are on every page; the rest is per page.
 *
 * The first two are facts about the site, not about the URL being rendered, and
 * a graph that only mentions the site on the home page gives a crawler arriving
 * from search — which is how nearly everyone arrives at a post — nothing to
 * attach that post to. Stating them everywhere under a stable `@id` is what
 * lets twenty-eight pages describe one publisher and one website.
 */
const structured_data = {
  "@context": "https://schema.org",
  "@graph": [publisher, website(Astro.site), ...nodes],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Theme, applied before the first paint.

      This has to be inline, synchronous, and in the head. A module script is
      deferred, so the page would paint in the default theme and then snap to
      the chosen one — a white flash on every navigation for anyone who picked
      dark. Wrapped in try/catch because reading localStorage throws outright
      when cookies are blocked, and a theme preference must never be the thing
      that stops a page rendering.
    -->
    <script is:inline>
      try {
        const choice = localStorage.getItem("theme");
        if (choice === "light" || choice === "dark") {
          document.documentElement.setAttribute("data-theme", choice);
        }
      } catch {}
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{full_title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fcfcfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0e14" media="(prefers-color-scheme: dark)" />

    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={full_title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />

    {/* The card. `alt` is read out by screen readers on X and LinkedIn, and the
        explicit dimensions let a crawler lay out the preview before the image
        has finished downloading. */}
    <meta property="og:image" content={og_image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={full_title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full_title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og_image} />
    <meta name="twitter:image:alt" content={full_title} />

    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structured_data)} />
  </head>

  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-sm focus:text-ink-100"
    >
      Skip to content
    </a>

    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Vercel's own two. Both inject a deferred script and render nothing, and
        both no-op outside a Vercel deployment, so `astro dev` is unaffected. */}
    <Analytics />
    <SpeedInsights />

    <script>
      /**
       * Scroll reveals. Everything marked `.reveal` fades up once, the first
       * time it is seen, and is then forgotten — elements that re-animate on
       * every pass make a page feel restless rather than alive.
       *
       * `prefers-reduced-motion` is handled entirely in CSS, so nothing here
       * needs to branch on it.
       */
      const targets = document.querySelectorAll<HTMLElement>(".reveal");

      if (!("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-in"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-in");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.1 },
        );

        targets.forEach((el) => observer.observe(el));
      }

      /**
       * In-page navigation without leaving "#metrics" in the address bar.
       *
       * The links stay real anchors in the markup — they have to work with
       * JavaScript off, and they are what a middle-click or a copied link
       * needs. This only changes what the bar shows afterwards.
       */
      function scrollToHash(hash: string, smooth: boolean) {
        const target = document.querySelector(hash);
        if (!target) return false;

        target.scrollIntoView({ behavior: smooth ? "smooth" : "auto", block: "start" });
        return true;
      }

      function stripHash() {
        history.replaceState(null, "", location.pathname + location.search);
      }

      // Arriving with a hash — following /#metrics from a post, say. Scroll
      // there, then tidy the bar.
      if (location.hash && location.hash !== "#main") {
        const arrived = location.hash;
        requestAnimationFrame(() => {
          if (scrollToHash(arrived, false)) stripHash();
        });
      }

      document.addEventListener("click", (event) => {
        const link = (event.target as HTMLElement | null)?.closest?.("a[href*='#']");
        if (!(link instanceof HTMLAnchorElement)) return;

        const url = new URL(link.href, location.href);
        // Another page's anchor, or the skip link — which must keep its native
        // behaviour, because that is what moves focus for a keyboard user.
        if (url.pathname !== location.pathname || !url.hash || url.hash === "#main") return;
        if (!scrollToHash(url.hash, true)) return;

        event.preventDefault();
        stripHash();
      });
    </script>
  </body>
</html>
