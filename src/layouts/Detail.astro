---
import Base from "./Base.astro";
import { SITE, CTA } from "../lib/site";
import { webPage } from "../lib/schema";

/**
 * A detail page behind a menu item.
 *
 * The nav used to point at anchors on the home page, which meant every item
 * scrolled you into the middle of one long document and the address bar had
 * to be tidied afterwards. These are pages: they have their own URL, their
 * own title, and they can say more than a landing section has room for.
 *
 * Centred, the same way a post is — the reading column sits in the middle of
 * the screen inside the site's standard container, so the page keeps the
 * structure while the content stays where the eye already is.
 */

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  description: string;
  /**
   * `prose` caps the body at a reading column; `full` hands the page the whole
   * container and lets it choose its own widths per section.
   *
   * The cap is right for prose and wrong for a product view. `/metrics` needs to
   * show the table those sixteen numbers actually live in, and a seven-column
   * table squeezed into 768px is a horizontal scroller — which is how a page
   * meant to build confidence ends up looking like it is hiding something. Pages
   * that are only prose keep the cap and do not have to think about it.
   */
  width?: "prose" | "full";
  /**
   * An "on this page" row under the lead, one chip per `id` on the page.
   *
   * These pages are long now. A reader arriving from search with one question
   * should not have to scroll a thousand words to find out whether it is
   * answered here — the chip row is the answer, and it doubles as a contents
   * list that says how much page there is.
   *
   * Real anchors, so they work with scripting off; `Base` already tidies the
   * hash out of the address bar afterwards.
   */
  sections?: readonly { id: string; label: string }[];
}

const {
  eyebrow,
  title,
  lead,
  description,
  width = "prose",
  sections = [],
} = Astro.props;

const prose = width === "prose";

/**
 * These three are documents, and now say so.
 *
 * `Base` defaults to `SoftwareApplication`, which is right for the home page
 * and wrong for a page explaining how a nightly pass works — the same product
 * described three more times, competing with itself. The layout knows its own
 * pages are prose, so it fills this in and no page has to remember to.
 */
const schema = webPage(Astro.site, { path: Astro.url.pathname, title, description });
---

<Base title={title} description={description} schema={schema}>
  <article>
    <header class="relative overflow-hidden border-b border-line-soft">
      <div aria-hidden="true" class="grid-fade absolute inset-0 -z-10"></div>

      <div class="mx-auto max-w-7xl px-5 pt-36 pb-14 sm:px-8 sm:pt-44">
        <div class="reveal mx-auto max-w-3xl">
          <p class="text-sm font-medium text-cyan">{eyebrow}</p>
          <h1
            class="mt-3 text-3xl font-semibold tracking-tight text-balance text-ink-100 sm:text-[2.75rem] sm:leading-[1.1]"
          >
            {title}
          </h1>
          <p class="mt-5 text-lg leading-8 text-pretty text-ink-500">{lead}</p>

          {
            sections.length > 0 && (
              <nav aria-label="On this page" class="mt-8 flex flex-wrap gap-2">
                {sections.map((section) => (
                  <a
                    href={`#${section.id}`}
                    class="rounded-lg border border-line bg-surface px-3 py-1.5 text-[13px] text-ink-300 transition-colors hover:border-line-strong hover:text-ink-100"
                  >
                    {section.label}
                  </a>
                ))}
              </nav>
            )
          }
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
      {prose ? <div class="mx-auto max-w-3xl"><slot /></div> : <slot />}
    </div>
  </article>

  <aside class="border-t border-line-soft">
    <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8">
      <div class="mx-auto max-w-3xl rounded-2xl border border-line bg-ink-900/40 p-7">
        <h2 class="text-lg font-semibold tracking-tight text-ink-100">
          Find out what your tools are actually doing
        </h2>
        <p class="mt-2 text-sm leading-6.5 text-ink-500">
          Create an MCP, paste the key, restart. Two lines inside your own process.
        </p>
        <a
          href={SITE.signup}
          class="mt-5 inline-flex h-10 items-center rounded-xl bg-btn px-4 text-sm font-medium text-btn-fg transition-colors hover:bg-btn-hover"
        >
          {CTA.primary}
        </a>
      </div>
    </div>
  </aside>
</Base>
