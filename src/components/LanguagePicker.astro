---
import { INSTALL_LANGUAGES } from "../lib/content";
import { SITE } from "../lib/site";

/**
 * Which language your server is written in — the first decision on the
 * installation page, and the one that changes everything under it.
 *
 * A card each rather than a select, matching the dashboard's own install page.
 * Ten items in a dropdown hides the thing a new reader most wants to know
 * before anything else: whether we support them at all.
 *
 * ── No JavaScript ──────────────────────────────────────────────────────────
 * It is a radio group. The inputs are visually hidden but real, so the whole
 * control arrives working: arrow keys move between languages, the selection
 * survives a back button, and it renders on a page with scripting off — which
 * matters more here than anywhere else on the site, because a reader deciding
 * whether to install something is exactly the reader running a strict browser.
 *
 * The showing and hiding is `:has()` on the wrapper, with one rule per
 * language generated below. Generated rather than written out, because ten
 * hand-copied triples of selectors is nine chances to point a card at the
 * wrong panel — and a wrong pairing looks like a working page.
 *
 * The TypeScript panel is the slot, because it is the actual instructions and
 * belongs on the page rather than inside a component about choosing. The other
 * nine are the same shape as each other and rendered from the list.
 */

const css = INSTALL_LANGUAGES.map(
  (language) => `
.langs:has(#lang-${language.id}:checked) [data-panel="${language.id}"] { display: block }
.langs:has(#lang-${language.id}:checked) [data-card="${language.id}"] {
  border-color: color-mix(in oklch, var(--color-cyan) 45%, transparent);
  background-color: var(--color-cyan-wash);
}
.langs:has(#lang-${language.id}:checked) [data-card="${language.id}"] .lang-tile {
  background-color: var(--color-btn);
  color: var(--color-btn-fg);
}
.langs:has(#lang-${language.id}:checked) [data-card="${language.id}"] .lang-name { color: var(--color-cyan) }
.langs:has(#lang-${language.id}:focus-visible) [data-card="${language.id}"] {
  outline: 2px solid var(--color-cyan);
  outline-offset: 2px;
}`,
).join("");
---

<div class="langs">
  <fieldset>
    <legend class="text-xl font-semibold tracking-tight text-ink-100">
      Your server's language
    </legend>
    {/* "TypeScript today. The rest are on the way" was true when one SDK
        existed. All ten are written now, each against the same conformance
        fixture, so the lead says that instead of apologising for nine of
        them. */}
    <p class="mt-3 text-[15px] leading-7 text-ink-500">
      All ten official MCP SDKs have an MCPulse package, each checked against the same wire-format
      fixture so they cannot drift apart. And none of them is a wall: ingest is a plain HTTP <code
        class="rounded bg-surface-2 px-1 py-0.5 font-mono text-[0.85em] text-ink-100">POST</code
      >, so a language without a package can still report today.
    </p>

    {/* The inputs, ahead of everything that reacts to them. Hidden with
        clip rather than `display: none`, which would take them out of the
        tab order and off the accessibility tree — the control would then
        be ten unreachable labels.

        The default is TypeScript by name, not "whichever one is available".
        All ten are available now, so a status test marked all ten `checked`
        and the browser kept the last radio it parsed — the page opened on
        Kotlin. Which one leads is an editorial choice regardless: TypeScript
        has the richest panel and the largest share of MCP servers. */}
    {
      INSTALL_LANGUAGES.map((language) => (
        <input
          type="radio"
          name="lang"
          id={`lang-${language.id}`}
          class="sr-only"
          checked={language.id === "typescript"}
        />
      ))
    }

    {/* Two across on a phone, five on a wide screen: ten in one row is a
        strip of unreadable labels, and one column is a page of scrolling
        before the instructions start. */}
    <div class="mt-6 grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-5">
      {
        INSTALL_LANGUAGES.map((language) => (
          <label
            for={`lang-${language.id}`}
            data-card={language.id}
            class="flex cursor-pointer flex-col items-start gap-2.5 rounded-xl border border-line bg-surface p-3 transition-colors hover:border-line-strong hover:bg-surface-2"
          >
            {/* A monogram, not a borrowed logo: ten brand marks is ten
                licences to check and ten SVGs to keep in step. */}
            <span
              aria-hidden="true"
              class="lang-tile flex h-7 w-9 shrink-0 items-center justify-center rounded-md bg-surface-3 font-mono text-[11px] font-semibold tracking-wide text-ink-500 transition-colors"
            >
              {language.short}
            </span>

            <span class="min-w-0">
              <span class="lang-name block truncate text-sm font-medium text-ink-100 transition-colors">
                {language.label}
              </span>
              {/* The state in words, on the card, so the grid reads without
                  selecting anything.

                  Three labels rather than two. "Coming soon" covered both a
                  finished package awaiting a release and a language nobody has
                  started, and flattening those told a Python author the least
                  useful version of the truth — their SDK is written and tested,
                  and the old label made it sound like an intention. */}
              <span
                class:list={[
                  "mt-1 block text-[11px]",
                  language.status === "available"
                    ? "text-ok"
                    : language.status === "written"
                      ? "text-cyan"
                      : "text-ink-700",
                ]}
              >
                {
                  language.status === "available"
                    ? "Available"
                    : language.status === "written"
                      ? "Written, unreleased"
                      : "Planned"
                }
              </span>
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="mt-12">
    <div data-panel="typescript" class="lang-panel">
      <slot />
    </div>

    {/*
      Every language except TypeScript, each with its own real steps.

      TypeScript keeps the `<slot />` above because the install page hands it a
      richer panel — the animated four-step sequence with the terminal, the
      .env and the wrap. The other nine get the same three beats in a plainer
      form: install, wrap, key.

      This block used to be a "Coming soon" card for nine languages. All ten
      SDKs exist, so the card was describing a state that had not been true for
      a while — a page telling a Go author to go and read the MCP Go SDK instead
      of telling them `go get`.
    */}
    {
      INSTALL_LANGUAGES.filter((language) => language.id !== "typescript").map((language) => (
        <div data-panel={language.id} class="lang-panel">
          <div class="rounded-2xl border border-line bg-ink-900/40 p-7">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <h2 class="text-xl font-semibold tracking-tight text-ink-100">
                Install for {language.label}
              </h2>
              {language.status === "written" && (
                <span class="rounded-md bg-warn-wash px-2 py-0.5 text-[11px] font-medium text-warn">
                  Package not published yet
                </span>
              )}
            </div>

            {/*
              The shape, said once, at the top.

              Six of the ten have no server object or middleware to attach to,
              so they wrap the handler body with `record()` instead. A reader
              who expects the TypeScript two-liner and meets a closure needs to
              know why before they read the code, not after.
            */}
            <p class="mt-3 text-[15px] leading-7 text-ink-500">
              {language.shape === "wrap"
                ? "Wrap the server you already built. It is handed straight back, so nothing downstream changes."
                : "Wrap your handler body. There is no server object to attach to here, so recording goes around the call instead of in front of it."}
            </p>

            <ol class="mt-7 space-y-6">
              <li>
                <p class="text-[13px] font-medium tracking-wide text-ink-700 uppercase">
                  1 · Add the package
                </p>
                <pre class="term mt-2.5 overflow-x-auto rounded-xl p-4 font-mono text-[13px] leading-6 text-ink-300">{language.install}</pre>
                {language.status === "written" && (
                  <p class="mt-2 text-[13px] leading-6 text-warn">
                    This resolves once the package is released. The implementation is complete and
                    tested against the same conformance fixture as the rest.
                  </p>
                )}
              </li>

              <li>
                <p class="text-[13px] font-medium tracking-wide text-ink-700 uppercase">
                  2 · {language.shape === "wrap" ? "Wrap your server" : "Wrap your handler"}
                </p>
                <pre class="term mt-2.5 overflow-x-auto rounded-xl p-4 font-mono text-[13px] leading-6 text-ink-300">{language.snippet}</pre>
              </li>

              <li>
                <p class="text-[13px] font-medium tracking-wide text-ink-700 uppercase">
                  3 · Add your key
                </p>
                <pre class="term mt-2.5 overflow-x-auto rounded-xl p-4 font-mono text-[13px] leading-6 text-ink-300">MCPULSE_KEY=mp_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx</pre>
                <p class="mt-2 text-[13px] leading-6 text-ink-700">
                  Shown once, when you create the MCP. An ingest key is a secret — anyone holding it
                  can write data into this MCP.
                </p>
              </li>
            </ol>

            <a
              href={`https://github.com/${language.sdk}`}
              target="_blank"
              rel="noreferrer noopener"
              class="mt-7 inline-flex items-center gap-1.5 font-mono text-[13px] text-cyan transition-colors hover:text-cyan-dim"
            >
              Pairs with {language.sdk}
              <svg
                class="h-3 w-3 shrink-0"
                viewBox="0 0 12 12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4" />
              </svg>
            </a>

            <hr class="my-7 border-0 border-t border-line-soft" />

            <h3 class="text-[15px] font-semibold text-ink-100">Or skip the package entirely</h3>
            <p class="mt-2.5 text-[15px] leading-7 text-ink-500">
              Ingest is one authenticated{" "}
              <code class="rounded bg-surface-2 px-1 py-0.5 font-mono text-[0.85em] text-ink-100">
                POST
              </code>{" "}
              with a bearer key and two payload shapes — one when your server boots, one per tool
              call. Any language that can make an HTTP request can report today; the package only
              exists to save you writing it.
            </p>

            <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
              <a
                href={`${SITE.docs}/api/concepts/ingest`}
                class="text-cyan underline underline-offset-2 transition-colors hover:text-cyan-dim"
              >
                The ingest endpoint
              </a>
              <a
                href={`${SITE.docs}/sdk/what-is-sent`}
                class="text-cyan underline underline-offset-2 transition-colors hover:text-cyan-dim"
              >
                Both payload shapes
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

{/* Hidden by default; the generated rules above reveal exactly one. Scoped
    styles would be rewritten with this component's hash and never match the
    generated selectors, so both halves are inline. */}
<style is:inline>
  .lang-panel {
    display: none;
  }
</style>

<style is:inline set:html={css}></style>
