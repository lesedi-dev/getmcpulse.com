---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { SITE } from "../lib/site";

const year = new Date().getFullYear();

const COLUMNS = [
  {
    heading: "Product",
    links: [
      /**
       * The checker is first, and it is the only link here with nothing to
       * lose by being clicked — no signup, no install, no price. Somebody who
       * arrives from the survey wanting to measure their own server should not
       * have to read four pages about us to find the thing that does it.
       *
       * It is **not** in `NAV`. The header comment in `site.ts` records where
       * that row stops fitting a small laptop, and a fifth link plus the button
       * is over it. The footer, the survey's closing section and the home page
       * carry it instead.
       */
      { href: "/check", label: "Schema checker" },
      { href: "/how-it-works", label: "How it works" },
      { href: "/metrics", label: "Metrics" },
      { href: "/install", label: "Installation" },
      { href: "/pricing", label: "Pricing" },
      { href: "/faq", label: "Questions" },
      { href: SITE.login, label: "Sign in" },
    ],
  },
  {
    /**
     * The blog's only home in the site chrome, now that it is out of the
     * header — so this column is the one that has to work. "All posts" is the
     * way in, the two beneath it are the ones worth starting on, and the feed
     * is for somebody who wants the rest without coming back.
     */
    heading: "Writing",
    links: [
      { href: "/blog", label: "All posts" },
      // The survey sits above the two evergreen starters: it is the one with
      // a number in it, and the only one somebody might have arrived looking
      // for by name.
      { href: "/blog/reading-5000-mcp-schemas", label: "The schema survey" },
      { href: "/blog/first-call-success", label: "First-call success" },
      { href: "/blog/empty-results-are-failures", label: "Empty results" },
      { href: "/rss.xml", label: "RSS" },
    ],
  },
  {
    heading: "Build with it",
    links: [
      { href: SITE.docs, label: "Documentation" },
      /**
       * The connector and the skill are two links, not one, because they are
       * two different things and the difference is why the skill exists.
       *
       * The connector is the plumbing — OAuth, and the tools an agent can call.
       * The skill is the workflow guide on top: which tool to reach for, how to
       * ask for a little rather than a lot, which figures are already computed
       * server-side and must not be re-derived. Listing only the connector
       * leaves an agent to infer all of that from tool descriptions, which is
       * the exact gap the skill was written to close.
       */
      { href: `${SITE.docs}/mcp/connect`, label: "MCP connector" },
      { href: `${SITE.docs}/mcp/skills`, label: "Agent skill" },
      { href: SITE.npm, label: "@mcpulse/sdk on npm" },
      { href: SITE.github, label: "GitHub" },
    ],
  },
] as const;
---

<footer class="border-t border-line-soft bg-ink-950">
  <div class="mx-auto max-w-7xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:pr-8">
        <div class="flex items-center gap-2.5 text-ink-100">
          <Logo class="h-4 w-auto text-cyan" />
          <span class="text-[15px] font-semibold tracking-tight">{SITE.name}</span>
        </div>
        <p class="mt-3 text-sm leading-6 text-ink-500">
          {SITE.tagline}. Never the arguments, never the results — sizes and hashes only.
        </p>
      </div>

      {
        COLUMNS.map((column) => (
          <div>
            <h2 class="text-xs font-medium tracking-wide text-ink-500 uppercase">
              {column.heading}
            </h2>
            {/* Padding on the anchor, not gaps on the list. A bare 14px link
                is a 17px-tall target, which is a miss on a phone — this takes
                each one to 33px without changing how the column looks. */}
            <ul class="mt-3 space-y-0.5 text-sm">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-block py-2 text-ink-300 transition-colors hover:text-cyan"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Theme sits down here rather than in the nav: it is a preference you
         set once, not a destination, and the header has to stay legible on a
         phone where four links already compete for the width. -->
    <div
      class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line-soft pt-6"
    >
      <p class="text-xs text-ink-700">© {year} {SITE.name}</p>
      <ThemeToggle />
    </div>
  </div>
</footer>
