---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { SITE } from "../lib/site";

const year = new Date().getFullYear();

const COLUMNS = [
  {
    heading: "Product",
    links: [
      { href: "/how-it-works", label: "How it works" },
      { href: "/metrics", label: "Metrics" },
      { href: "/install", label: "Install" },
      { href: SITE.app, label: "Sign in" },
    ],
  },
  {
    heading: "Writing",
    links: [
      { href: "/blog", label: "All posts" },
      { href: "/blog/first-call-success", label: "First-call success" },
      { href: "/blog/empty-results-are-failures", label: "Empty results" },
      { href: "/rss.xml", label: "RSS" },
    ],
  },
  {
    heading: "Package",
    links: [
      { href: SITE.npm, label: "@mcpulse/sdk on npm" },
      { href: SITE.github, label: "GitHub" },
    ],
  },
] as const;
---

<footer class="border-t border-line-soft bg-ink-950">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:pr-8">
        <div class="flex items-center gap-2.5 text-ink-100">
          <Logo class="h-4 w-auto text-cyan" />
          <span class="text-[15px] font-semibold tracking-tight">{SITE.name}</span>
        </div>
        <p class="mt-3 text-sm leading-6 text-ink-500">
          {SITE.tagline}. Never the arguments, never the results — sizes and hashes only.
        </p>
      </div>

      {
        COLUMNS.map((column) => (
          <div>
            <h2 class="text-xs font-medium tracking-wide text-ink-500 uppercase">
              {column.heading}
            </h2>
            {/* Padding on the anchor, not gaps on the list. A bare 14px link
                is a 17px-tall target, which is a miss on a phone — this takes
                each one to 33px without changing how the column looks. */}
            <ul class="mt-3 space-y-0.5 text-sm">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-block py-2 text-ink-300 transition-colors hover:text-cyan"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Theme sits down here rather than in the nav: it is a preference you
         set once, not a destination, and the header has to stay legible on a
         phone where four links already compete for the width. -->
    <div
      class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line-soft pt-6"
    >
      <p class="text-xs text-ink-700">© {year} {SITE.name}</p>
      <ThemeToggle />
    </div>
  </div>
</footer>
