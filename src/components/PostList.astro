---
import PostHero from "./PostHero.astro";
import Pagination from "./Pagination.astro";
import type { CollectionEntry } from "astro:content";

/**
 * The blog listing, shared by `/blog` and `/blog/page/N`.
 *
 * Extracted from `index.astro` when the archive was paginated, because the
 * alternative was a second copy of a 144-line three-tier layout that would
 * have drifted from the first the moment either was touched.
 *
 * ── The tiers, and why page one is different ──────────────────────────────
 * Page one leads with a spread for the newest post and half-rows for the two
 * behind it, because recency is a real recommendation for the first three
 * items and stops being one after that. Later pages are a plain grid: post
 * thirty-one is not more important than post thirty-two, and giving it a
 * spread would say it was.
 */

interface Props {
  /** This page's posts, newest first. */
  posts: CollectionEntry<"blog">[];
  /** Page one gets the featured spread; later pages get an even grid. */
  featuredFirst?: boolean;
  current: number;
  total: number;
}

const { posts, featuredFirst = false, current, total } = Astro.props;

const [lead, ...tail] = posts;
const featured = featuredFirst ? lead : undefined;
const seconds = featuredFirst ? tail.slice(0, 2) : [];
const others = featuredFirst ? tail.slice(2) : posts;

const format = (date: Date) =>
  date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });

const CHIP = "rounded-full bg-cyan-wash px-2.5 py-1 text-xs font-medium text-cyan";
const META = "flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-ink-700";
/** One card shell, so the three tiers cannot drift apart on radius or hover. */
const CARD =
  "group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-colors hover:border-cyan/25 hover:bg-surface-2";
/**
 * The cover's own frame. `overflow-hidden` is on the frame rather than the
 * card so the image can scale inside it without the card's own corners
 * clipping the text below.
 */
const FRAME = "relative overflow-hidden border-b border-line bg-ink-950/50";
/**
 * No `h-full`. The height comes from the aspect ratio on a card and from
 * `inset-0` on the featured spread; adding one more source of it is how a
 * cover ends up 2:1 in one breakpoint and square in the next.
 */
const IMAGE = "w-full transition-transform duration-700 ease-out-quint group-hover:scale-[1.04]";
---

  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    {/* ── The spread ──────────────────────────────────────────────────────
        Text and image side by side on a wide screen, so the cover gets a
        full half of the page rather than a band across the top of a card.
        The image is second in the markup and pulled first by `order`, so a
        screen reader and a phone both get the words before the picture. */}
    {
      featured && (
        <a href={`/blog/${featured.id}`} class={`reveal ${CARD} lg:grid lg:grid-cols-2`}>
          <div class={`${FRAME} lg:order-2 lg:border-b-0 lg:border-l`}>
            <PostHero
              slug={featured.id}
              title={featured.data.title}
              eager
              class={`${IMAGE} aspect-[2/1] lg:absolute lg:inset-0 lg:aspect-auto lg:h-full`}
            />
          </div>

          <div class="flex flex-col justify-center p-7 sm:p-10 lg:order-1">
            <div class={META}>
              <span class={CHIP}>{featured.data.topic}</span>
              <span>Latest</span>
              <span aria-hidden="true">·</span>
              <time datetime={featured.data.published.toISOString()}>
                {format(featured.data.published)}
              </time>
              <span aria-hidden="true">·</span>
              <span>{featured.data.minutes} min read</span>
            </div>

            <h2 class="mt-5 text-2xl leading-tight font-semibold tracking-tight text-balance text-ink-100 transition-colors group-hover:text-cyan sm:text-[2rem]">
              {featured.data.title}
            </h2>
            <p class="mt-4 text-[15px] leading-7 text-pretty text-ink-500">
              {featured.data.description}
            </p>

            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-cyan">
              Read it
              <svg
                class="h-3.5 w-3.5 shrink-0 transition-transform duration-300 group-hover:translate-x-0.5"
                viewBox="0 0 14 14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2 7h10M8 3l4 4-4 4" />
              </svg>
            </span>
          </div>
        </a>
      )
    }

    {/* ── Two, half a row each ─────────────────────────────────────────── */}
    <ul class="mt-5 grid gap-5 lg:grid-cols-2">
      {
        seconds.map((post, i) => (
          <li class="reveal" style={`--reveal-delay: ${i * 90}ms`}>
            <a href={`/blog/${post.id}`} class={CARD}>
              <div class={FRAME}>
                <PostHero
                  slug={post.id}
                  title={post.data.title}
                  class={`${IMAGE} aspect-[2/1]`}
                />
              </div>

              <div class="flex flex-1 flex-col p-7">
                <div class={META}>
                  <span class={CHIP}>{post.data.topic}</span>
                  <time datetime={post.data.published.toISOString()}>
                    {format(post.data.published)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>{post.data.minutes} min</span>
                </div>

                <h2 class="mt-4 text-xl leading-7 font-semibold tracking-tight text-balance text-ink-100 transition-colors group-hover:text-cyan">
                  {post.data.title}
                </h2>
                <p class="mt-2.5 flex-1 text-sm leading-6.5 text-pretty text-ink-500">
                  {post.data.description}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    {/* ── The archive ──────────────────────────────────────────────────── */}
    {
      others.length > 0 && (
        <>
          <h2 class="reveal mt-16 flex items-center gap-4 text-xs font-medium tracking-wide text-ink-700 uppercase">
            {featuredFirst ? "More writing" : `Page ${current} of ${total}`}
            <span aria-hidden="true" class="h-px flex-1 bg-line-soft" />
          </h2>

          {/*
            Three columns, inside a `max-w-7xl` container.

            Every card renders the same 1200×630 image the post page uses, so
            how legible it is here is purely a function of how wide the card
            is. At three columns in the old `max-w-6xl` container a card was
            349px — a 0.29 scale, where the title inside landed near 17px and
            the domain under it near 6px, which is why it read on a post and
            not here. The wider container takes the card to ~392px and the
            scale to 0.33.
          */}
          <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((post, i) => (
              <li class="reveal" style={`--reveal-delay: ${(i % 3) * 80}ms`}>
                <a href={`/blog/${post.id}`} class={CARD}>
                  <div class={FRAME}>
                    <PostHero
                      slug={post.id}
                      title={post.data.title}
                      class={`${IMAGE} aspect-[2/1]`}
                    />
                  </div>

                  <div class="flex flex-1 flex-col p-6">
                    <div class={META}>
                      <span class="font-medium text-cyan-dim">{post.data.topic}</span>
                      <span aria-hidden="true">·</span>
                      <span>{post.data.minutes} min</span>
                    </div>

                    <h3 class="mt-3 text-[17px] leading-6.5 font-semibold tracking-tight text-balance text-ink-100 transition-colors group-hover:text-cyan">
                      {post.data.title}
                    </h3>
                    <p class="mt-2.5 flex-1 text-sm leading-6.5 text-ink-500">
                      {post.data.description}
                    </p>

                    <time
                      datetime={post.data.published.toISOString()}
                      class="mt-5 text-xs text-ink-700"
                    >
                      {format(post.data.published)}
                    </time>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  
    <Pagination current={current} total={total} class="reveal mt-16" />
  </div>
